# Copy to .env and adjust: cp .env.example .env  (Windows: Copy-Item .env.example .env)
# The app reads .env when started on the host. Under docker compose the URLs below are
# overridden with the container hostnames (see docker-compose.yml).

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=call_results
MONGODB_TIMEOUT_MS=5000

# RabbitMQ (producer.py reads RABBITMQ_URL from the environment, not from .env)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
PREFETCH_COUNT=10

# Retries: unexpected processing error -> requeue after RETRY_DELAY_SECONDS;
# MongoDB unavailable -> retry in place with backoff up to STORAGE_RETRY_MAX_DELAY_SECONDS.
RETRY_DELAY_SECONDS=1.0
STORAGE_RETRY_MAX_DELAY_SECONDS=30.0

# Reconnect to RabbitMQ with exponential backoff.
RECONNECT_INITIAL_DELAY_SECONDS=1.0
RECONNECT_MAX_DELAY_SECONDS=30.0

LOG_LEVEL=INFO
